# Copy this file to `.env` (which is git-ignored) and fill in the value.
# Never put a real key in this file: it IS committed.
#
# Nothing in the project loads .env on its own. Ask uv to:
#   uv run --env-file .env uvicorn app.main:app --reload
#   uv run --env-file .env python scripts/try_prompt.py --example array_aliasing
#
# Plain KEY=value lines: no spaces around the =, no quotes needed.

ANTHROPIC_API_KEY=

# Optional. Comma-separated origins allowed to call the API from a browser.
# Defaults to the Next.js dev server.
# CORS_ORIGINS=http://localhost:3000

# Optional. Set to 0 to turn off the server-side refusal fallback (a beta API
# parameter) if the API ever rejects it. On by default.
# REFUSAL_FALLBACK=1
