# Copy this file to `.env` (which is git-ignored) and fill in the value.
# Never put a real key in this file: it IS committed.
#
# Nothing in the project loads .env on its own. Ask uv or uvicorn to:
#   uv run --env-file .env python scripts/try_prompt.py --example array_aliasing
#   uv run --env-file .env uvicorn app.main:app --reload
#
# Plain KEY=value lines: no spaces around the =, no quotes needed.

ANTHROPIC_API_KEY=
